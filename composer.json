{
    "name": "vivutio/vivutio",
    "type": "library",
    "description": "The vivutio core: identity, the shell, the registry, places, partners and the hub connection, shipped as one package and one version.",
    "keywords": [
        "core",
        "platform",
        "symfony",
        "tourism",
        "travel",
        "vivutio"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Ezekiel Mjema",
            "homepage": "https://github.com/eemjema"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-filter": "*",
        "ext-mbstring": "*",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.5",
        "doctrine/persistence": "^3.1 || ^4.0",
        "symfony/asset": "^8.0",
        "symfony/console": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/doctrine-bridge": "^8.0",
        "symfony/http-foundation": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/password-hasher": "^8.0",
        "symfony/routing": "^8.0",
        "symfony/security-bundle": "^8.0",
        "symfony/security-core": "^8.0",
        "symfony/security-csrf": "^8.0",
        "symfony/security-http": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "symfony/uid": "^8.0",
        "twig/twig": "^3.21"
    },
    "replace": {
        "vivutio/connect-bundle": "self.version",
        "vivutio/contracts": "self.version",
        "vivutio/identity-bundle": "self.version",
        "vivutio/partner-bundle": "self.version",
        "vivutio/place-bundle": "self.version",
        "vivutio/registry-bundle": "self.version",
        "vivutio/shell-bundle": "self.version"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "maglnet/composer-require-checker": "^4.16",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.2",
        "symfony/browser-kit": "^8.0",
        "symfony/css-selector": "^8.0",
        "symfony/dom-crawler": "^8.0",
        "symfony/filesystem": "^8.0",
        "symfony/framework-bundle": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Vivutio\\Bundle\\": "src/Vivutio/Bundle/",
            "Vivutio\\Bundle\\IdentityBundle\\Migrations\\": "src/Vivutio/Bundle/IdentityBundle/migrations/",
            "Vivutio\\Contracts\\": "src/Vivutio/Contracts/"
        },
        "exclude-from-classmap": [
            "**/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Vivutio\\Bundle\\IdentityBundle\\Tests\\": "src/Vivutio/Bundle/IdentityBundle/tests/",
            "Vivutio\\Contracts\\Tests\\": "src/Vivutio/Contracts/tests/",
            "Vivutio\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs:fix": "php-cs-fixer fix",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
        "test": "phpunit",
        "require-check": "@php require-check",
        "check": [
            "@cs:check",
            "@phpstan",
            "@require-check",
            "@test"
        ]
    },
    "config": {
        "process-timeout": 1800,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
