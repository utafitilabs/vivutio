<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true">
    <!--
        No KERNEL_CLASS. The core is one repository with one phpunit config and
        several bundles, so an env var could only ever name one of their
        kernels; every test names its own in code.
    -->
    <php>
        <!--
            One database for the whole core. Port 5434 is the local PostgreSQL
            server, 5432 in CI. A specification empties it, so it is named for
            this repository alone and used by nothing else.
        -->
        <env name="VIVUTIO_TEST_DATABASE_URL"
             value="postgresql://app:app@127.0.0.1:5434/vivutio_core_test?serverVersion=17&amp;charset=utf8"/>
    </php>
    <testsuites>
        <!--
            The core as one installation: the specifications that are about the
            bundles together, not about any one of them.
        -->
        <testsuite name="Core">
            <directory>tests/Core</directory>
        </testsuite>
        <!-- One suite per package: a suite is a package, exactly as after a split. -->
        <testsuite name="A stand-in module">
            <directory>tests/Application/NotesModule</directory>
        </testsuite>

        <testsuite name="Contracts">
            <directory>src/Vivutio/Contracts/tests</directory>
        </testsuite>
        <testsuite name="IdentityBundle">
            <directory>src/Vivutio/Bundle/IdentityBundle/tests</directory>
        </testsuite>
        <testsuite name="PartnerBundle">
            <directory>src/Vivutio/Bundle/PartnerBundle/tests</directory>
        </testsuite>
        <testsuite name="PlaceBundle">
            <directory>src/Vivutio/Bundle/PlaceBundle/tests</directory>
        </testsuite>
        <testsuite name="ShellBundle">
            <directory>src/Vivutio/Bundle/ShellBundle/tests</directory>
        </testsuite>
    </testsuites>
    <source restrictNotices="true" restrictWarnings="true">
        <include>
            <directory>src</directory>
        </include>
        <exclude>
            <directory>src/Vivutio/Bundle/*/tests</directory>
            <directory>src/Vivutio/Contracts/tests</directory>
        </exclude>
    </source>
</phpunit>
