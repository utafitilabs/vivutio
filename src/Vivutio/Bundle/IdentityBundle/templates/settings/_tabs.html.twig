{# Settings' tabs: Organization, and Deletions for Super Admins. Drawn only
   when there is more than one. #}
{% macro tabs(current) %}
{% if is_granted('identity.delete') %}
<nav class="tabs" aria-label="Settings"><a href="{{ path('identity_settings_organization') }}"{{ current == 'organization' ? ' aria-current="page"' }}>Organization</a><a href="{{ path('identity_settings_deletions') }}"{{ current == 'deletions' ? ' aria-current="page"' }}>Deletions</a></nav>
{% endif %}
{% endmacro %}
