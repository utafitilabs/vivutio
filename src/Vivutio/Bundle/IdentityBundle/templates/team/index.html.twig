{# The team list, ported from uhifadhi's table: one row per person, one column
   per fact, the filters above. Its look comes from the design of the screen;
   what it shows and to whom is settled here.

   The filter bar is a GET form and the chips are links, so a filtered list
   lives in the address: it can be bookmarked and survives the back button.
   Every count is over the whole team. Tiers are shown to Super Admins alone,
   and an address to whoever may read personal details. #}
{% extends '@Shell/document.html.twig' %}

{% block title %}Team{% endblock %}

{% block body %}
<main>
    <h1>Team</h1>

    {% if page.isFirstRun %}
        <p data-first-run>One account, and it is yours. A Super Admin needs no position: the tier passes every permission check on its own. Nobody you add will have that.</p>
    {% else %}
        <form data-tools method="get" action="{{ path('identity_team') }}">
            <input type="search" name="q" value="{{ query.q }}" placeholder="{{ door('personal_details.read') ? 'Name or email' : 'Name' }}" aria-label="Search the team">

            {% if with_tiers %}
                <div data-facet="tier">
                    <a data-chip href="{{ path('identity_team', query.toParams({tier: null, page: null})) }}">All <span>{{ page.everyone }}</span></a>
                    {% for tier in tiers %}
                        <a data-chip href="{{ path('identity_team', query.toParams({tier: tier.value, page: null})) }}">{{ tier.label }} <span>{{ page.tierCounts[tier.value] }}</span></a>
                    {% endfor %}
                </div>
            {% endif %}

            <div data-facet="position">
                <a data-chip href="{{ path('identity_team', query.toParams({position: null, page: null})) }}">Any position <span>{{ page.everyone }}</span></a>
                {% for position in page.positions %}
                    <a data-chip href="{{ path('identity_team', query.toParams({position: position.uuid, page: null})) }}">{{ position.name }} <span>{{ position.count }}</span></a>
                {% endfor %}
                <a data-chip href="{{ path('identity_team', query.toParams({position: 'none', page: null})) }}">No position <span>{{ page.noPosition }}</span></a>
            </div>

            <div data-facet="account">
                <a data-chip href="{{ path('identity_team', query.toParams({account: null, page: null})) }}">Any account <span>{{ page.everyone }}</span></a>
                <a data-chip href="{{ path('identity_team', query.toParams({account: 'active', page: null})) }}">Active <span>{{ page.active }}</span></a>
                <a data-chip href="{{ path('identity_team', query.toParams({account: 'deactivated', page: null})) }}">Deactivated <span>{{ page.deactivated }}</span></a>
            </div>

            <span data-shown>showing {{ page.people|length }} of {{ page.total }}</span>
        </form>
    {% endif %}

    <table>
        <thead><tr><th>Person</th>{% if with_tiers %}<th>Tier</th>{% endif %}<th>Position</th><th>Account</th></tr></thead>
        <tbody>
        {% for person in page.people %}
            <tr data-person="{{ person.fullName }}">
                <td><b>{{ person.fullName }}</b>{% if door('personal_details.read') %} <a href="mailto:{{ person.email }}">{{ person.email }}</a>{% endif %}</td>
                {% if with_tiers %}<td data-tier>{{ person.tier.label }}</td>{% endif %}
                <td>{{ person.position ? person.position.name : 'No position' }}</td>
                <td>{{ person.active ? 'Active' : 'Deactivated' }}</td>
            </tr>
        {% else %}
            <tr><td colspan="{{ with_tiers ? 4 : 3 }}">
                <div data-nobody>Nobody matches {% if query.q %}“{{ query.q }}”{% else %}these filters{% endif %}. <a href="{{ path('identity_team') }}">Show the whole team</a>.</div>
            </td></tr>
        {% endfor %}
        </tbody>
    </table>

    <div data-pager>
        <span>{{ page.total }} {{ page.total == 1 ? 'person' : 'people' }} · {{ page.perPage }} per page</span>
        <span>
            {% if page.page > 1 %}<a href="{{ path('identity_team', query.toParams({page: page.page - 1})) }}" aria-label="Previous page">‹</a>{% endif %}
            page {{ page.page }} of {{ page.pages }}
            {% if page.page < page.pages %}<a href="{{ path('identity_team', query.toParams({page: page.page + 1})) }}" aria-label="Next page">›</a>{% endif %}
        </span>
    </div>
</main>
{% endblock %}
