{# The positions, ported from uhifadhi's register (team/positions/index.html):
   the tiers above the matrix, then every position with what it grants and
   who holds it. Adding one is the tiers' alone. #}
{% extends '@Shell/page.html.twig' %}
{% import '@Shell/_icons.html.twig' as icons %}
{% import '@Identity/positions/_macros.html.twig' as positions %}

{% block title %}Positions{% endblock %}
{% block here %}positions{% endblock %}

{% block page %}
<header class="page-head"><div><nav class="trail" aria-label="Where you are">Organization / Positions</nav><div class="title"><h1>Positions</h1><span class="about">What each grants, and who holds it</span></div></div></header>

<div class="stack">
    <section class="panel small" data-tiers>
        <div class="action"><div><b>Above the matrix</b><span>The tiers hold every permission by tier, and are never a row here</span></div></div>
        <div class="action"><div><b>Staff</b><span>Exactly what their position grants; nothing by default</span></div></div>
    </section>

    {% if door('positions.configure') %}
    <form class="panel" method="post" action="{{ path('identity_position_add') }}" novalidate>
        <header class="panel-head"><h2>Add a position</h2><p>It grants nothing until it is given what it grants</p></header>
        <input type="hidden" name="_token" value="{{ csrf_token('position_add') }}">
        {% if expired %}<div class="notice danger" role="alert">{{ icons.icon('alert') }}<span>The form had expired, so nothing was saved. Add it again.</span></div>{% endif %}
        <div class="grid-2"><div class="field{{ wrong ? ' wrong' }}"><label for="position-name">Name</label><input class="input" id="position-name" name="name" value="{{ typed }}" required maxlength="120">{% if wrong %}<div class="hint"><span>{{ wrong }}</span></div>{% endif %}</div></div>
        <footer class="panel-foot"><span class="state"></span><button type="submit" class="button main">Add the position</button></footer>
    </form>
    {% endif %}

    <section class="panel list">
        <table class="table">
            <thead><tr><th>Position</th><th>Grants</th><th style="width:110px">Sensitive</th><th style="width:170px">Holders</th><th style="width:90px"></th></tr></thead>
            <tbody>
            {% for summary in summaries %}
                {%- set position = summary.position -%}
                <tr data-position="{{ position.name }}">
                    <td><div class="who"><span class="initials">{{ positions.initials(position.name) }}</span><div><b>{{ position.name }}</b></div></div></td>
                    <td data-grants>{{ positions.grants_line(summary) }}</td>
                    <td data-sensitive>{{ summary.sensitive > 0 ? summary.sensitive : '—' }}</td>
                    <td data-holders="{{ summary.holders|length }}">{% if summary.holders is empty %}<span class="quiet">Nobody</span>{% else %}{{ summary.holders|length }} {{ summary.holders|length == 1 ? 'person' : 'people' }}{% endif %}</td>
                    <td><a class="button outline" href="{{ path('identity_position', {uuid: position.uuid}) }}">Open</a></td>
                </tr>
            {% else %}
                <tr><td colspan="5"><div class="empty"><b>No positions yet</b><span>A position is what Staff hold: add one, then say what it grants.</span></div></td></tr>
            {% endfor %}
            </tbody>
        </table>
    </section>
</div>
{% endblock %}
