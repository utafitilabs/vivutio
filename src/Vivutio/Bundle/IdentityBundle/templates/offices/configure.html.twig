{# Configuring an office: its name, city and country. #}
{% extends '@Shell/page.html.twig' %}
{% import '@Shell/_icons.html.twig' as icons %}
{% import '@Identity/positions/_macros.html.twig' as positions %}

{% block title %}Configure {{ office.name }}{% endblock %}
{% block here %}offices{% endblock %}

{% block page %}
<header class="page-head">
    <span class="initials">{{ positions.initials(office.name) }}</span>
    <div><nav class="trail" aria-label="Where you are"><a href="{{ path('identity_offices') }}">Offices</a> / <a href="{{ path('identity_office', {uuid: office.uuid}) }}">{{ office.name }}</a> / Configure</nav><div class="title"><h1>{{ office.name }}</h1></div></div>
    <div class="actions"><a class="button outline" href="{{ path('identity_office', {uuid: office.uuid}) }}">{{ icons.icon('record', 15) }} View office</a></div>
</header>

<form class="panel" method="post" action="{{ path('identity_office_configure', {uuid: office.uuid}) }}" novalidate>
    <header class="panel-head"><h2>Office</h2><p>Its name and where it is</p></header>
    <input type="hidden" name="_token" value="{{ csrf_token('office_configure') }}">
    {% if expired %}<div class="notice danger" role="alert">{{ icons.icon('alert') }}<span>The form had expired, so nothing was saved. Save again.</span></div>{% endif %}
    <div class="grid-3">
        {% for field, label in {name: 'Name', city: 'City', country: 'Country'} %}
            <div class="field{{ wrong[field] is defined ? ' wrong' }}"><label for="office-{{ field }}">{{ label }}</label><input class="input" id="office-{{ field }}" name="{{ field }}" value="{{ typed[field] ?? '' }}" required>{% if wrong[field] is defined %}<div class="hint"><span>{{ wrong[field] }}</span></div>{% endif %}</div>
        {% endfor %}
    </div>
    <footer class="panel-foot"><span class="state">Nothing is saved until Save</span><button type="reset" class="button quiet">Discard</button><button type="submit" class="button main">Save office</button></footer>
</form>
{% endblock %}
