{# An office's page, after uhifadhi's station record: who is posted there,
   since when, and which departments sit there. The posting is one fact,
   written on the person's page too. #}
{% extends '@Shell/page.html.twig' %}
{% import '@Shell/_icons.html.twig' as icons %}
{% import '@Identity/positions/_macros.html.twig' as positions %}

{% block title %}{{ summary.office.name }}{% endblock %}
{% block here %}offices{% endblock %}

{% block page %}
{%- set office = summary.office -%}
<header class="page-head">
    <span class="initials">{{ positions.initials(office.name) }}</span>
    <div><nav class="trail" aria-label="Where you are"><a href="{{ path('identity_offices') }}">Offices</a> / {{ office.name }}</nav><div class="title"><h1>{{ office.name }}</h1><span class="about">{{ office.city }}, {{ office.country }}</span></div></div>
    <div class="actions"><a class="button outline" href="{{ path('identity_offices') }}">{{ icons.icon('left', 15) }} Back to offices</a>{% if door('offices.configure') %}<a class="button outline" href="{{ path('identity_office_configure', {uuid: office.uuid}) }}">Configure</a>{% endif %}</div>
</header>

{% if saved %}<div class="notice" role="status">{{ icons.icon('check') }}<span>The office is saved.</span></div>{% endif %}

<div class="band">
    <span class="f"><span class="k">Posted</span><span class="v">{{ summary.posted|length }}<em>{{ summary.posted|length == 1 ? 'person' : 'people' }}</em></span></span>
    <span class="f"><span class="k">Departments</span><span class="v">{{ summary.departments|length }}<em>sit here</em></span></span>
</div>

<div class="columns">
    <section class="panel" data-posted>
        <header class="panel-head"><h2>Posted here</h2><p>Set on each person's Position card</p></header>
        {% for person in summary.posted %}
            <div class="fact" data-person="{{ person.fullName }}"><span><a href="{{ path('identity_team_member', {uuid: person.uuid}) }}">{{ person.fullName }}</a></span><b>{{ person.postedSince ? 'since ' ~ person.postedSince|date('j M Y') : '' }}</b></div>
        {% else %}
            <p class="hint">Nobody is posted here yet.</p>
        {% endfor %}
    </section>
    <aside class="aside stack">
        <section class="panel small" data-departments>
            <header class="panel-head"><h2>Departments here</h2></header>
            {% for department in summary.departments %}
                <div class="action" data-department="{{ department.name }}"><div><a href="{{ path('identity_department', {uuid: department.uuid}) }}"><b>{{ department.name }}</b></a></div></div>
            {% else %}
                <p class="hint">No department sits here; the organization's serve it.</p>
            {% endfor %}
        </section>
    </aside>
</div>
{% endblock %}
