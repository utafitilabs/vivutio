{
    "name": "vivutio/identity-bundle",
    "type": "symfony-bundle",
    "description": "The vivutio identity: the organisation, its users, tiers and positions, the permissions packages declare and the voters that decide them.",
    "keywords": [
        "identity",
        "symfony",
        "tourism",
        "travel",
        "vivutio"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Ezekiel Mjema",
            "homepage": "https://github.com/eemjema"
        }
    ],
    "require": {
        "php": ">=8.4",
        "symfony/http-kernel": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Vivutio\\Bundle\\IdentityBundle\\": ""
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Vivutio\\Bundle\\IdentityBundle\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
