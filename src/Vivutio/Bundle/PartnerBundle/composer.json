{
    "name": "vivutio/partner-bundle",
    "type": "symfony-bundle",
    "description": "The vivutio partner bundle: the organizations an installation trades with and the channel each is reached through.",
    "keywords": [
        "partner",
        "symfony",
        "tourism",
        "travel",
        "vivutio"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Ezekiel Mjema",
            "homepage": "https://github.com/eemjema"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-filter": "*",
        "ext-mbstring": "*",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.5",
        "doctrine/persistence": "^3.1 || ^4.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/doctrine-bridge": "^8.0",
        "symfony/http-foundation": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/intl": "^8.0",
        "symfony/routing": "^8.0",
        "symfony/security-csrf": "^8.0",
        "symfony/security-http": "^8.0",
        "symfony/uid": "^8.0",
        "twig/twig": "^3.21",
        "vivutio/contracts": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Vivutio\\Bundle\\PartnerBundle\\": ""
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Vivutio\\Bundle\\PartnerBundle\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
