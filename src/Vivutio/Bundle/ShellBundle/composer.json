{
    "name": "vivutio/shell-bundle",
    "type": "symfony-bundle",
    "description": "The vivutio shell: the design system, the layouts and the navigation every module is drawn in.",
    "keywords": [
        "shell",
        "symfony",
        "tourism",
        "travel",
        "vivutio"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Ezekiel Mjema",
            "homepage": "https://github.com/eemjema"
        }
    ],
    "require": {
        "php": ">=8.4",
        "symfony/asset": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/http-foundation": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/routing": "^8.0",
        "symfony/security-core": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "twig/twig": "^3.21",
        "vivutio/contracts": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Vivutio\\Bundle\\ShellBundle\\": ""
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Vivutio\\Bundle\\ShellBundle\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
