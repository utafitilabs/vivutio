{# The frame every signed-in page wears, as designed in
   vivutio-designs/shell/dashboard.html: one bar across the top, the menu under
   it listing only what the person may open, the page in one centred column.

   A page names where it sits in the menu with the `here` block, and fills
   `page`. Search and notifications are drawn as coming until their features
   exist; the organization's name heads the menu once it is recorded. #}
{% extends '@Shell/document.html.twig' %}
{% import '@Shell/_icons.html.twig' as icons %}

{% block body %}
{%- set signed_in = app.user -%}
{%- set organization = organization() -%}
<header class="bar">
    <a class="brand" href="{{ path('shell_dashboard') }}">{% include '@Shell/_mark.html.twig' with {size: 28} only %}<span>vivutio</span></a>
    <button type="button" class="fold" onclick="foldMenu()" title="Fold or open the menu" aria-label="Fold or open the menu">{{ icons.icon('fold') }}</button>
    <label class="search" title="Search is coming">{{ icons.icon('search', 16) }}<input type="search" placeholder="Search people, properties, bookings" aria-label="Search" disabled><kbd>/</kbd></label>
    <button type="button" class="bar-icon" title="Notifications are coming" aria-label="Notifications are coming" disabled>{{ icons.icon('bell') }}</button>
    <button type="button" class="bar-icon" onclick="toggleTheme()" title="Dark or light" aria-label="Dark or light">{{ icons.icon('theme') }}</button>
    <details class="me">
        <summary class="bar-me">
            {#- Under the name the tiers read their tier; Staff, who see no
                tier anywhere, read their position. -#}
            <span><b>{{ signed_in.fullName }}</b><small>{{ signed_in.tier.holdsEveryPermission ? signed_in.tier.label : (signed_in.position ? signed_in.position.name : 'No position') }}</small></span>
            <i>{{ signed_in.initials }}</i>
        </summary>
        <div class="pick-menu"><a href="{{ path('identity_logout') }}">Sign out</a></div>
    </details>
</header>
<div class="shell">
    <nav class="menu" aria-label="Menu">
        {%- set here = block('here') is defined ? block('here')|trim : '' -%}
        {% if organization %}<h2>{{ organization.name }}</h2>{% endif %}
        <a href="{{ path('shell_dashboard') }}" title="Dashboard"{{ 'dashboard' == here ? ' class="here"' }}>{{ icons.icon('dashboard') }}<span>Dashboard</span></a>
        {% if door('directory.read') or door('positions.read') or door('departments.read') or door('settings.read') %}<h2>Organization</h2>{% endif %}
        {% if door('directory.read') %}
            <a href="{{ path('identity_team') }}" title="Team"{{ 'team' == here ? ' class="here"' }}>{{ icons.icon('users') }}<span>Team</span></a>
        {% endif %}
        {% if door('departments.read') %}
            <a href="{{ path('identity_departments') }}" title="Departments"{{ 'departments' == here ? ' class="here"' }}>{{ icons.icon('departments') }}<span>Departments</span></a>
        {% endif %}
        {% if door('positions.read') %}
            <a href="{{ path('identity_positions') }}" title="Positions"{{ 'positions' == here ? ' class="here"' }}>{{ icons.icon('seat') }}<span>Positions</span></a>
        {% endif %}
        {% if door('settings.read') %}
            <a href="{{ path('identity_settings_organization') }}" title="Settings"{{ 'settings' == here ? ' class="here"' }}>{{ icons.icon('settings') }}<span>Settings</span></a>
        {% endif %}
    </nav>
    <main>
        <div class="page">
            {% block page %}{% endblock %}
        </div>
    </main>
</div>
{% endblock %}
